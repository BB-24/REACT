{
  "$schema": "https://schema.management.azure.com/schemas/2016-06-01/Microsoft.Logic.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "containmentFunctionUrl": { "type": "String" },
    "acquisitionArmRequestUrl": { "type": "String" },
    "acquisitionStatusUrl": { "type": "String" },
    "acquisitionStatusAudience": { "type": "String" },
    "analysisPipelineUrl": { "type": "String" },
    "analysisApiAudience": { "type": "String" },
    "evidenceBlobUriTemplate": { "type": "String" }
  },
  "triggers": {
    "Incident_Webhook": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "required": [
            "IncidentID",
            "TargetVM",
            "IPAddress",
            "SubscriptionID",
            "IncidentSeverity"
          ],
          "properties": {
            "IncidentID": { "type": "string", "minLength": 1 },
            "TargetVM": { "type": "string", "minLength": 1, "description": "Full Azure resource ID of the target VM." },
            "IPAddress": { "type": "string", "minLength": 1 },
            "SubscriptionID": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
            "IncidentSeverity": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
            "ResourceGroupName": { "type": "string" },
            "TestMode": { "type": "boolean", "description": "Return containment output immediately for an isolated P1-P2 integration test. Use only with a dedicated test VM." }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "actions": {
    "Parse_Incident": {
      "type": "ParseJson",
      "inputs": {
        "content": "@triggerBody()",
        "schema": {
          "type": "object",
          "required": [
            "IncidentID",
            "TargetVM",
            "IPAddress",
            "SubscriptionID",
            "IncidentSeverity"
          ],
          "properties": {
            "IncidentID": { "type": "string" },
            "TargetVM": { "type": "string" },
            "IPAddress": { "type": "string" },
            "SubscriptionID": { "type": "string" },
            "IncidentSeverity": { "type": "string" },
            "ResourceGroupName": { "type": "string" },
            "TestMode": { "type": "boolean" }
          }
        }
      },
      "runAfter": {}
    },
    "High_Or_Critical_Severity_Only": {
      "type": "If",
      "expression": {
        "or": [
          { "equals": ["@body('Parse_Incident')?['IncidentSeverity']", "High"] },
          { "equals": ["@body('Parse_Incident')?['IncidentSeverity']", "Critical"] }
        ]
      },
      "actions": {
        "Call_Network_Containment": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "@parameters('containmentFunctionUrl')",
            "headers": { "Content-Type": "application/json" },
            "body": "@body('Parse_Incident')"
          },
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs"] }
          },
          "runAfter": {}
        },
        "Containment_Test_Mode": {
          "type": "If",
          "expression": {
            "equals": ["@body('Parse_Incident')?['TestMode']", true]
          },
          "actions": {
            "Return_Containment_Result": {
              "type": "Response",
              "inputs": {
                "statusCode": "@coalesce(outputs('Call_Network_Containment')?['statusCode'], 502)",
                "headers": { "Content-Type": "application/json" },
                "body": "@coalesce(body('Call_Network_Containment'), json('{\"status\":\"Failed\",\"error\":\"Containment endpoint did not return a response.\"}'))"
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {
              "Check_Containment_Success": {
                "type": "If",
                "expression": {
                  "or": [
                    { "equals": ["@outputs('Call_Network_Containment')['statusCode']", 200] },
                    { "equals": ["@body('Call_Network_Containment')?['status']", "Bypassed"] }
                  ]
                },
                "actions": {
                  "Start_Acquisition_Workflow": {
                    "type": "Http",
                    "inputs": {
                      "method": "POST",
                      "uri": "@parameters('acquisitionArmRequestUrl')",
                      "headers": { "Content-Type": "application/json" },
                      "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com/" },
                      "body": {
                        "IncidentID": "@body('Parse_Incident')?['IncidentID']",
                        "TargetVM": "@body('Parse_Incident')?['TargetVM']",
                        "IPAddress": "@body('Parse_Incident')?['IPAddress']",
                        "SubscriptionID": "@body('Parse_Incident')?['SubscriptionID']",
                        "IncidentSeverity": "@body('Parse_Incident')?['IncidentSeverity']",
                        "EvidenceBlobUri": "@format(parameters('evidenceBlobUriTemplate'), body('Parse_Incident')?['IncidentID'], last(split(body('Parse_Incident')?['TargetVM'], '/')))"
                      }
                    },
                    "runtimeConfiguration": {
                      "secureData": { "properties": ["inputs"] }
                    },
                    "runAfter": {}
                  },
                  "Wait_For_Evidence_Acquisition": {
                    "type": "Until",
                    "expression": "@or(equals(body('Get_Acquisition_Status')?['status'], 'Completed'), equals(body('Get_Acquisition_Status')?['status'], 'Failed'))",
                    "limit": { "count": 240, "timeout": "PT2H" },
                    "actions": {
                      "Get_Acquisition_Status": {
                        "type": "Http",
                        "inputs": {
                          "method": "GET",
                          "uri": "@concat(parameters('acquisitionStatusUrl'), '?incidentId=', encodeUriComponent(body('Parse_Incident')?['IncidentID']))",
                          "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('acquisitionStatusAudience')" }
                        },
                        "runtimeConfiguration": {
                          "secureData": { "properties": ["inputs"] }
                        },
                        "runAfter": {}
                      },
                      "Delay_Before_Retry": {
                        "type": "Wait",
                        "inputs": { "interval": { "count": 30, "unit": "Second" } },
                        "runAfter": { "Get_Acquisition_Status": ["Succeeded"] }
                      }
                    },
                    "runAfter": { "Start_Acquisition_Workflow": ["Succeeded"] }
                  },
                  "Check_Acquisition_Completed": {
                    "type": "If",
                    "expression": {
                      "equals": ["@body('Get_Acquisition_Status')?['status']", "Completed"]
                    },
                    "actions": {
                      "Start_Analysis_Pipeline": {
                        "type": "Http",
                        "inputs": {
                          "method": "POST",
                          "uri": "@parameters('analysisPipelineUrl')",
                          "headers": { "Content-Type": "application/json" },
                          "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('analysisApiAudience')" },
                          "body": {
                            "IncidentID": "@body('Parse_Incident')?['IncidentID']",
                            "TargetVM": "@body('Parse_Incident')?['TargetVM']",
                            "IPAddress": "@body('Parse_Incident')?['IPAddress']",
                            "SubscriptionID": "@body('Parse_Incident')?['SubscriptionID']",
                            "IncidentSeverity": "@body('Parse_Incident')?['IncidentSeverity']",
                            "EvidenceBlobUri": "@format(parameters('evidenceBlobUriTemplate'), body('Parse_Incident')?['IncidentID'], last(split(body('Parse_Incident')?['TargetVM'], '/')))",
                            "ContainmentDetails": "@body('Call_Network_Containment')",
                            "PipelineStatus": "AcquisitionCompleted",
                            "Timestamp": "@{utcNow()}"
                          }
                        },
                        "runtimeConfiguration": {
                          "secureData": { "properties": ["inputs"] }
                        },
                        "runAfter": {}
                      }
                    },
                    "else": {
                      "actions": {
                        "Record_Acquisition_Failure": {
                          "type": "Compose",
                          "inputs": {
                            "IncidentID": "@body('Parse_Incident')?['IncidentID']",
                            "Error": "Evidence acquisition reported Failed.",
                            "AcquisitionStatus": "@body('Get_Acquisition_Status')",
                            "Timestamp": "@{utcNow()}"
                          },
                          "runAfter": {}
                        }
                      }
                    },
                    "runAfter": { "Wait_For_Evidence_Acquisition": ["Succeeded"] }
                  }
                },
                "else": {
                  "actions": {
                    "Record_Containment_Failure": {
                      "type": "Compose",
                      "inputs": {
                        "IncidentID": "@body('Parse_Incident')?['IncidentID']",
                        "Error": "Containment function returned non-200 status (not Contained or Bypassed)",
                        "ContainmentStatus": "@body('Call_Network_Containment')?['status']",
                        "Details": "@body('Call_Network_Containment')",
                        "Timestamp": "@{utcNow()}"
                      },
                      "runAfter": {}
                    }
                  }
                }
              }
            }
          },
          "runAfter": { "Call_Network_Containment": ["Succeeded", "Failed"] }
        }
      },
      "else": {
        "actions": {
          "Ignored_Non_Severe_Incident": {
            "type": "Compose",
            "inputs": "@concat('Incident ', body('Parse_Incident')?['IncidentID'], ' was not contained because its severity is neither High nor Critical.')",
            "runAfter": {}
          }
        }
      },
      "runAfter": { "Parse_Incident": ["Succeeded"] }
    }
  },
  "outputs": {}
}
