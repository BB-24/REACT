# Python virtual environments and caches
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/

# Node artifacts. This is a Python project; `npm install` inside a function
# directory is always a mistake.
node_modules/

# Forensic artifacts must never be committed. Evidence lives in the enclave
# storage account, hashed into the SQL ledger -- never in source control.
*.raw
*.lime
*.mem
*.dmp

# Acquisition tool binaries (WinPmem, AVML, lime.ko) are fetched at deploy time.
src/scripts/tools/

# Azure Functions local settings (CRITICAL: Prevents leaking local connection strings)
local.settings.json
.vscode/

# OS generated files
.DS_Store
Thumbs.db

# Terraform/Bicep state (if used locally)
.terraform/
*.tfstate
*.tfstate.backup