# Python virtual environments and caches
__pycache__/
*.py[cod]
.venv/
venv/
env/
/scripts/*
!/scripts/demo.py
!/scripts/run-azure-demo.ps1
src/scripts/tools/

# Azure Functions local settings (CRITICAL: Prevents leaking local connection strings)
local.settings.json

# Local deployment parameters may contain Azure subscription and principal IDs.
iac/parameters/*.parameters.json
!iac/parameters/*.parameters.example.json

# OS generated files
.DS_Store
Thumbs.db

# Terraform/Bicep state (if used locally)
.terraform/
*.tfstate
*.tfstate.backup
# Node.js dependencies
node_modules/

# Test & coverage artifacts
.coverage
coverage.xml
coverage_html/
junit/
sample-evidence-output/
src/functions/.pytest_cache/
src/functions/.coverage
src/functions/.python_packages/
