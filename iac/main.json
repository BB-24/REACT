    {
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}-apply-legal-hold', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "kind": "AzureCLI",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-legalhold-{1}', parameters('namePrefix'), substring(variables('suffix'), 0, 8))))]": {}
        }
      },
      "properties": {
        "azCliVersion": "2.59.0",
        "retentionInterval": "PT1H",
        "timeout": "PT30M",
        "environmentVariables": [
          {
            "name": "ACCOUNT",
            "value": "[variables('storageAccountName')]"
          },
          {
            "name": "GROUP",
            "value": "[resourceGroup().name]"
          },
          {
            "name": "CONTAINERS",
            "value": "[format('{0} memory-dumps disk-snapshots analysis-output reports', parameters('evidenceContainerName'))]"
          },
          {
            "name": "TAGS",
            "value": "[join(parameters('legalHoldTags'), ' ')]"
          }
        ],
        "scriptContent": "      set -euo pipefail\r\n      for c in $CONTAINERS; do\r\n        echo \"Processing legal hold on container: $c\"\r\n        existing=$(az storage container legal-hold show \\\r\n          --account-name \"$ACCOUNT\" --resource-group \"$GROUP\" \\\r\n          --container-name \"$c\" --query \"tags\" -o tsv 2>/dev/null || echo \"\")\r\n        if [ -n \"$existing\" ]; then\r\n          echo \"Legal hold already present on $c: $existing\"\r\n        else\r\n          az storage container legal-hold set \\\r\n            --account-name \"$ACCOUNT\" --resource-group \"$GROUP\" \\\r\n            --container-name \"$c\" --tags $TAGS\r\n          echo \"Legal hold applied to $c: $TAGS\"\r\n        fi\r\n\r\n        # Verify hold is active and fail deployment if not active (prevents false reporting)\r\n        has_hold=$(az storage container legal-hold show \\\r\n          --account-name \"$ACCOUNT\" --resource-group \"$GROUP\" \\\r\n          --container-name \"$c\" --query \"hasLegalHold\" -o tsv)\r\n        if [ \"$has_hold\" != \"true\" ]; then\r\n          echo \"ERROR: Legal hold verification failed on container $c\" >&2\r\n          exit 1\r\n        fi\r\n      done\r\n      echo \"Legal hold successfully verified on all evidence containers.\"\r\n    "
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers/immutabilityPolicies', variables('storageAccountName'), 'default', 'analysis-output', 'default')]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers/immutabilityPolicies', variables('storageAccountName'), 'default', 'disk-snapshots', 'default')]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers/immutabilityPolicies', variables('storageAccountName'), 'default', parameters('evidenceContainerName'), 'default')]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-legalhold-{1}', parameters('namePrefix'), substring(variables('suffix'), 0, 8)))]",
        "[extensionResourceId(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-legalhold-{1}', parameters('namePrefix'), substring(variables('suffix'), 0, 8))), 'contributor'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers/immutabilityPolicies', variables('storageAccountName'), 'default', 'memory-dumps', 'default')]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers/immutabilityPolicies', variables('storageAccountName'), 'default', 'reports', 'default')]"
      ]
    },
    {
      "condition": "[parameters('lockRetentionPolicy')]",
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}-lock-retention', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "kind": "AzureCLI",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-legalhold-{1}', parameters('namePrefix'), substring(variables('suffix'), 0, 8))))]": {}
        }
      },
      "properties": {
        "azCliVersion": "2.59.0",
        "retentionInterval": "PT1H",
        "timeout": "PT30M",
        "environmentVariables": [
          {
            "name": "ACCOUNT",
            "value": "[variables('storageAccountName')]"
          },
          {
            "name": "GROUP",
            "value": "[resourceGroup().name]"
          },
          {
            "name": "CONTAINERS",
            "value": "[format('{0} memory-dumps disk-snapshots analysis-output reports', parameters('evidenceContainerName'))]"
          }
        ],
        "scriptContent": "      set -euo pipefail\r\n      for c in $CONTAINERS; do\r\n        etag=$(az storage container immutability-policy show \\\r\n          --account-name \"$ACCOUNT\" --resource-group \"$GROUP\" \\\r\n          --container-name \"$c\" --query etag -o tsv)\r\n        state=$(az storage container immutability-policy show \\\r\n          --account-name \"$ACCOUNT\" --resource-group \"$GROUP\" \\\r\n          --container-name \"$c\" --query state -o tsv)\r\n        if [ \"$state\" = \"Locked\" ]; then\r\n          echo \"Immutability policy already locked on $c.\"\r\n        else\r\n          az storage container immutability-policy lock \\\r\n            --account-name \"$ACCOUNT\" --resource-group \"$GROUP\" \\\r\n            --container-name \"$c\" --if-match \"$etag\"\r\n          echo \"Immutability policy locked on $c.\"\r\n        fi\r\n      done\r\n    "
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deploymentScripts', format('{0}-apply-legal-hold', parameters('namePrefix')))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-legalhold-{1}', parameters('namePrefix'), substring(variables('suffix'), 0, 8)))]"
      ]
    },
